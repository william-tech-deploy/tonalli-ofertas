<?xml version="1.0" encoding="utf-8"?>
<!-- SOLO en la versión de depuración: permite HTTP hacia la computadora que
     ejecuta el emulador (10.0.2.2), para probar con un Supabase local.
     La versión release usa src/main/res/xml/red.xml, que prohíbe HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
