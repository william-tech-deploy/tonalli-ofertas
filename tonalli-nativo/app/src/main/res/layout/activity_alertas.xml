<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tonalli_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/tonalli_background"
        app:titleTextAppearance="@style/TonalliTituloBarra" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tonalli_outline_subtle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tarjeta: nueva alerta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TonalliEtiqueta"
                android:layout_marginTop="0dp"
                android:text="Nueva alerta" />

            <TextView
                style="@style/TonalliEtiqueta"
                android:labelFor="@+id/etPalabra"
                android:text="Producto" />

            <EditText
                android:id="@+id/etPalabra"
                style="@style/TonalliCampo"
                android:hint="Ej. Leche en polvo"
                android:inputType="text"
                android:maxLength="40" />

            <TextView
                style="@style/TonalliEtiqueta"
                android:labelFor="@+id/etMax"
                android:text="Avisar si baja de" />

            <EditText
                android:id="@+id/etMax"
                style="@style/TonalliCampo"
                android:hint="5.00"
                android:inputType="numberDecimal"
                android:maxLength="9" />

            <Button
                android:id="@+id/btnAgregar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="Crear alerta" />
        </LinearLayout>

        <TextView
            style="@style/TonalliEtiqueta"
            android:text="Tus alertas · mantén presionada una para eliminarla" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tarjeta"
            android:padding="1dp">

            <ListView
                android:id="@+id/lvAlertas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@drawable/linea"
                android:dividerHeight="1dp" />

            <TextView
                android:id="@+id/tvVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="Aún no tienes alertas."
                android:textColor="@color/tonalli_on_surface_muted"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
