<?xml version="1.0" encoding="utf-8"?>
<!-- La raíz recibe el espacio del teclado como relleno inferior; el ScrollView de adentro se
     achica y desplaza el campo activo para que siempre quede a la vista. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tonalli_background"
    android:orientation="vertical">

<ScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnCerrar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar"
            android:src="@drawable/ic_cerrar" />

        <ImageView
            android:layout_width="52dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/bricolage"
            android:text="Tonalli"
            android:textColor="@color/tonalli_on_background"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ofertas con temperatura real"
            android:textColor="@color/tonalli_on_surface_muted"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_segmentos"
            android:padding="4dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoModo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/btnModoLogin"
                    style="@style/TonalliSegmento"
                    android:text="Iniciar sesión" />

                <Button
                    android:id="@+id/btnModoRegistro"
                    style="@style/TonalliSegmento"
                    android:text="Crear cuenta" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </FrameLayout>

        <TextView
            style="@style/TonalliEtiqueta"
            android:layout_marginTop="20dp"
            android:labelFor="@+id/etCorreo"
            android:text="Correo" />

        <EditText
            android:id="@+id/etCorreo"
            style="@style/TonalliCampo"
            android:autofillHints="emailAddress"
            android:hint="tu@correo.com"
            android:importantForAutofill="yes"
            android:inputType="textEmailAddress"
            android:maxLength="254" />

        <LinearLayout
            android:id="@+id/grupoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/TonalliEtiqueta"
                android:labelFor="@+id/etUsuario"
                android:text="Nombre de usuario (público)" />

            <EditText
                android:id="@+id/etUsuario"
                style="@style/TonalliCampo"
                android:autofillHints="username"
                android:hint="Ej. cazador_ana"
                android:importantForAutofill="yes"
                android:inputType="textNoSuggestions"
                android:maxLength="20" />
        </LinearLayout>

        <TextView
            style="@style/TonalliEtiqueta"
            android:labelFor="@+id/etClave"
            android:text="Contraseña" />

        <EditText
            android:id="@+id/etClave"
            style="@style/TonalliCampo"
            android:autofillHints="password"
            android:hint="Tu contraseña"
            android:importantForAutofill="yes"
            android:inputType="textPassword"
            android:maxLength="72" />

        <TextView
            android:id="@+id/tvAyudaClave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mínimo 10 caracteres. Una frase larga es más segura que una palabra con símbolos."
            android:textColor="@color/tonalli_on_surface_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEnviar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="Iniciar sesión" />
    </LinearLayout>
</ScrollView>
</LinearLayout>
