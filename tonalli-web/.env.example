# Copia este archivo a ".env" y cambia TODOS los valores. El archivo .env NO se sube a GitHub.

# Contraseñas de la base de datos (usa algo largo y aleatorio, por ejemplo: openssl rand -base64 24)
DB_PASSWORD=cambia-esta-clave-de-la-base
DB_ROOT_PASSWORD=cambia-esta-otra-clave-root

# Primer administrador (la contraseña debe tener entre 12 y 64 caracteres)
TONALLI_ADMIN_CORREO=admin@tu-dominio.com
TONALLI_ADMIN_PASSWORD=cambia-esta-clave-del-admin

# Datos de ejemplo (5 usuarios y 15 ofertas). SOLO para pruebas locales: en producción déjalo en false.
TONALLI_DEMO=false
# Contraseña común de los usuarios de ejemplo (12 a 64 caracteres). Vacía = no se puede entrar con ellos.
TONALLI_DEMO_PASSWORD=

# Dirección pública del sitio (se usa en el enlace del correo de verificación)
BASE_URL=http://localhost:8080

# Con HTTPS activo poner true
COOKIE_SECURE=false

# Si no hay SMTP configurado, ponlo en false SOLO para pruebas; en producción debe ser true.
VERIFICACION_OBLIGATORIA=true

# Correo de verificación mediante un servicio SMTP de terceros (Brevo, Mailjet, SES...)
MAIL_FROM=no-reply@tu-dominio.com
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Solo para el perfil "https" de docker compose
DOMINIO=
