# Copia este archivo a ".env", rellénalo y NUNCA lo subas a Git (ya está en .gitignore).
# Genera el pepper con:  openssl rand -base64 48     (guárdalo también en un gestor de contraseñas)
# ¡NO lo cambies después de que haya usuarios: nadie podría iniciar sesión! El servidor lo detecta y se niega a arrancar.
PASSWORD_PEPPER=

# Dominio público de la API (Caddy obtiene el certificado HTTPS para este dominio)
API_DOMAIN=api.tudominio.com
PUBLIC_BASE_URL=https://api.tudominio.com

# Orígenes que pueden llamar a la API desde un navegador/WebView (exactos, separados por coma, sin comodín).
# https://appassets.androidplatform.net es el origen del WebView de la app Android.
CORS_ORIGINS=https://tudominio.com,https://appassets.androidplatform.net

# Correo (obligatorio en producción: verificación de cuenta y recuperación de contraseña)
MAIL_DRIVER=resend
RESEND_API_KEY=
MAIL_FROM=Tonalli <no-reply@tudominio.com>

# Opcionales (valores por defecto seguros)
# REQUIRE_APPROVAL=true       # toda oferta nueva espera aprobación de un moderador
# REGISTRATION_ENABLED=true
# GLOBAL_RATE_PER_MIN=300
# NEW_ACCOUNT_HOURS=24
# LOG_LEVEL=info
